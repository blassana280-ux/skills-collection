# =============================================================================
# OMNI-RESEARCH 100 — configuration (copier vers .env, ne jamais committer .env)
# Aucune clé n'est obligatoire : sans clé, le connecteur est préparé mais
# déclaré « non configuré ». Aucun résultat de recherche n'est simulé.
# =============================================================================

# --- Application -------------------------------------------------------------
OMNI_ENV=development
OMNI_HOST=0.0.0.0
OMNI_PORT=8000
OMNI_PUBLIC_BASE_URL=http://localhost:8000
OMNI_LOG_LEVEL=INFO
# Origines autorisées à embarquer l'interface dans une iframe (sources CSP).
# Vide = politique stricte (X-Frame-Options: DENY, frame-ancestors 'none').
# Préviews / développement uniquement : ignoré quand OMNI_ENV=production.
# Exemple : OMNI_FRAME_ANCESTORS=https://*.e2b.app https://*.arena.ai
OMNI_FRAME_ANCESTORS=
# Secret de signature JWT. À CHANGER en production (openssl rand -hex 32).
OMNI_AUTH_SECRET=dev-only-change-me-please-32-bytes-minimum
OMNI_TOKEN_TTL_MINUTES=720
# Mot de passe du compte admin initial (hashé au démarrage, jamais stocké en clair)
OMNI_ADMIN_PASSWORD=change-me-admin
OMNI_USER_PASSWORD=change-me-user
# Clé d'API dédiée à l'adaptateur OmniBrain (envoyée dans X-OmniBrain-Key)
OMNI_OMNIBRAIN_API_KEY=change-me-omnibrain-key

# --- Persistance -------------------------------------------------------------
# SQLite par défaut (développement / tests). PostgreSQL = source de vérité en prod.
OMNI_DATABASE_URL=sqlite:///./data/omni_research.db
# OMNI_DATABASE_URL=postgresql+psycopg://omni:omni@postgres:5432/omni_research
# File de tâches : vide = file en mémoire (interface identique, non distribuée)
OMNI_REDIS_URL=
# OMNI_REDIS_URL=redis://redis:6379/0
# Index vectoriel : vide = index local (cosinus, sans dépendance)
OMNI_QDRANT_URL=
# OMNI_QDRANT_URL=http://qdrant:6333
OMNI_QDRANT_COLLECTION=omni_research_evidence
OMNI_RETENTION_DAYS=90

# --- Fournisseurs de recherche -----------------------------------------------
# SearXNG : auto-hébergé, aucune clé. Doit être joignable pour être actif.
OMNI_SEARXNG_URL=http://searxng:8080
OMNI_SEARXNG_ENABLED=true
OMNI_TAVILY_API_KEY=
OMNI_TAVILY_BASE_URL=https://api.tavily.com
OMNI_BRAVE_API_KEY=
OMNI_BRAVE_BASE_URL=https://api.search.brave.com
OMNI_EXA_API_KEY=
OMNI_EXA_BASE_URL=https://api.exa.ai
OMNI_FIRECRAWL_API_KEY=
OMNI_FIRECRAWL_BASE_URL=https://api.firecrawl.dev/v1

# Quotas journaliers par fournisseur (0 = illimité)
OMNI_QUOTA_SEARXNG=0
OMNI_QUOTA_TAVILY=100
OMNI_QUOTA_BRAVE=100
OMNI_QUOTA_EXA=100
OMNI_QUOTA_FIRECRAWL=100

# --- Fournisseurs de modèles (interchangeables, tous optionnels) --------------
# extractive = synthèse déterministe locale, sans LLM (valeur par défaut)
OMNI_LLM_PROVIDER=extractive
OMNI_OPENAI_BASE_URL=https://api.openai.com/v1
OMNI_OPENAI_API_KEY=
OMNI_OPENAI_MODEL=gpt-4o-mini
OMNI_ANTHROPIC_BASE_URL=https://api.anthropic.com
OMNI_ANTHROPIC_API_KEY=
OMNI_ANTHROPIC_MODEL=claude-3-5-haiku-latest
OMNI_OLLAMA_BASE_URL=http://ollama:11434
OMNI_OLLAMA_MODEL=llama3.1

# --- Limites et fiabilité -----------------------------------------------------
OMNI_MAX_PARALLEL_AGENTS=8
OMNI_MAX_CONCURRENT_MISSIONS=4
OMNI_MAX_SOURCES_PER_MISSION=60
OMNI_MAX_EXTRACTIONS_PER_MISSION=12
OMNI_HTTP_TIMEOUT_SECONDS=12
OMNI_MAX_CONTENT_BYTES=262144
OMNI_MAX_QUERY_LENGTH=600
OMNI_RATE_LIMIT_PER_MINUTE=60
OMNI_PROVIDER_FAILURE_COOLDOWN_SECONDS=30

# --- Vérification SSRF / environnement hors ligne -----------------------------
# Laisser true en production. Mettre false UNIQUEMENT pour des tests hors ligne
# (le contrôle syntaxique des URL reste toujours actif).
OMNI_DNS_SSRF_CHECK=true
# Nombre maximal d'agents mobilisés par mission (MAXIMUM = 100 par défaut)
OMNI_MAX_AGENTS_PER_MISSION=100
# Adaptateur OmniBrain : répertoire de la file JSONL compatible omni_queue.py
OMNI_OMNIBRAIN_QUEUE_DIR=./data/omnibrain-queue
# Plugins de fournisseurs additionnels : package.module:Classe, séparés par virgules
OMNI_PROVIDER_PLUGINS=
# Origines CORS autorisées (vide = même origine uniquement)
OMNI_CORS_ORIGINS=
# Secret de l'instance SearXNG du docker-compose
OMNI_SEARXNG_SECRET=change-this-searxng-secret
