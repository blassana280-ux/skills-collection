[Unit]
Description=OmniBrain SUPREME — worker %i (bail/heartbeat/fencing)
After=supreme-api.service

[Service]
Type=simple
WorkingDirectory=@FRAMEWORK@
EnvironmentFile=-%h/.config/supreme/env
ExecStart=@PYTHON@ -m supreme worker --interval 1 --lease-seconds 30 --heartbeat-seconds 5 --worker-id systemd-%i
Restart=on-failure
RestartSec=5
TimeoutStopSec=60
KillSignal=SIGTERM
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=@FRAMEWORK@/var

[Install]
WantedBy=default.target
