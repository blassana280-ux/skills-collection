# Modèle de configuration SUPREME — À COPIER HORS DÉPÔT puis renseigner.
#
#   install -m 600 ops/env.example ~/.config/supreme/env
#
# Ne jamais commiter le fichier renseigné. Ne jamais coller une clé dans une
# conversation, une issue, une PR ou un journal. Les unités systemd lisent ce
# fichier via EnvironmentFile ; le dépôt ne contient que ce modèle vide.

# --- Runtime ---------------------------------------------------------------
# Répertoire des données (défaut : <framework>/var/supreme). Permissions 0700.
# SUPREME_VAR_DIR=/srv/supreme/var

# --- API -------------------------------------------------------------------
# Liaison locale par défaut. Exposer publiquement exige une décision humaine
# explicite, un reverse proxy TLS et une authentification renforcée.
SUPREME_BIND=127.0.0.1
SUPREME_PORT=8765
# Lecture anonyme : 0 par défaut. 1 uniquement pour une preview contrôlée.
SUPREME_ALLOW_ANON_READ=0
# Jeton admin : laisser vide pour génération automatique en 0600 dans
# var/supreme/api_token.txt. Ne pas mettre de valeur en clair ici.
# SUPREME_API_TOKEN=

# --- Fournisseurs IA -------------------------------------------------------
# Priorité 1 : Mistral AI (« Vide »). Trois voies sûres, par ordre de préférence :
#   1) python3 -m supreme providers --connect mistral   (saisie masquée, TTY)
#   2) MISTRAL_API_KEY_FILE pointant vers un fichier 0600 hors dépôt
#   3) variable injectée par un gestionnaire de secrets
# Aucune clé n'est stockée dans ce modèle.
# MISTRAL_API_KEY_FILE=/home/USER/.config/supreme/mistral.key
# OPENAI_API_KEY_FILE=/home/USER/.config/supreme/openai.key
# DEEPSEEK_API_KEY_FILE=/home/USER/.config/supreme/deepseek.key
# GEMINI_API_KEY_FILE=/home/USER/.config/supreme/gemini.key
# OPENROUTER_API_KEY_FILE=/home/USER/.config/supreme/openrouter.key

# --- Limites d'exploitation ------------------------------------------------
SUPREME_WORKERS=1
# SUPREME_PYTHON=/usr/bin/python3

# Rappel : l'inférence externe reste FERMÉE par défaut même avec une clé.
# Elle exige une autorisation humaine bornée en CLI :
#   providers --set-prices ... --confirm 'JE CONFIRME LES PRIX'
#   providers --attest-context ... --confirm 'JE CONFIRME LE CONTEXTE'  (si non exposé par l'API)
#   providers --authorize mistral --budget-usd 0.25 --max-calls 5 --hours 1 --confirm 'AUTORISER INFERENCE'
